# Singto environment variables
#
# Copy to .env.local for local work, or add each one in
# Vercel → Project → Settings → Environment Variables.
# These are placeholders only: never commit real values
# (.env and .env.local are in .gitignore).

# ---------- Database (Neon PostgreSQL) ----------
# Neon → your project → Connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- LINE Messaging API channel (the Singto bot) ----------
# LINE Developers Console → Messaging API channel →
# Basic settings → Channel secret.
LINE_CHANNEL_SECRET=your-messaging-api-channel-secret
# Messaging API tab → Channel access token (long-lived) → Issue.
LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-channel-access-token

# ---------- LINE Login channel (LIFF web pages) ----------
# LINE Login channel → Basic settings → Channel ID.
# Used to verify users' LINE ID tokens on the server.
LINE_LOGIN_CHANNEL_ID=1234567890
# LINE Login channel → LIFF tab → LIFF ID (e.g. 1234567890-AbCdEfGh).
# The same value twice: the server builds links with LIFF_ID,
# the web pages read VITE_LIFF_ID at build time.
LIFF_ID=1234567890-AbCdEfGh
VITE_LIFF_ID=1234567890-AbCdEfGh

# ---------- App ----------
# Public URL of the deployed site. Only used when LIFF_ID
# is missing, as a fallback for the bot's "create event" link.
APP_BASE_URL=https://your-project.vercel.app
# Any long random string. Vercel Cron sends it to
# /api/cron/cleanup (30-day data clean-up); without it the
# clean-up refuses to run.
CRON_SECRET=replace-with-a-long-random-string

# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL are set by
# Vercel automatically; do not add them.
